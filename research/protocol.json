{
  "version": "research-v2.0",
  "question": "Among directed pairs active in the previous 4 hours, which recur in the next 24 hours?",
  "lookback_hours": 4,
  "horizon_hours": 24,
  "stride_hours": 24,
  "utc_cutoff_hour": 0,
  "warmup_days": 30,
  "test_fraction_starts": [0.5, 0.6, 0.7, 0.8, 0.9],
  "test_fraction_width": 0.1,
  "validation_fraction_width": 0.1,
  "validation_tuning_fraction": 0.5,
  "purge_rule": "label_end <= start_of_next_partition",
  "seeds": [2026, 2027, 2028],
  "optuna_trials": 16,
  "neural_max_epochs": 4,
  "primary_metric": "average_precision_on_all_candidates",
  "secondary_metrics": ["roc_auc", "f1", "mcc", "brier", "precision_at_5_per_day", "recall_at_5_per_day"],
  "bootstrap_repeats": 1000,
  "bootstrap_block_days": 7,
  "primary_comparison": ["Full LightGBM", "History HGB"],
  "secondary_comparisons": [["Full LightGBM", "No types LightGBM"], ["Hybrid ensemble", "Full LightGBM"]],
  "datasets": ["mathoverflow", "askubuntu"],
  "disclosure": "MathOverflow v1 test results and whole-dataset counts were previously viewed. These folds are retrospective evaluation, not a new untouched confirmatory test. AskUbuntu is a separate-dataset replication under this fixed protocol."
}
